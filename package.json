{
  "name": "pediaquiz-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "functions",
    "packages/types"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build:types": "npm run build --workspace=@pediaquiz/types",
    "build:functions": "npm run build --workspace=@pediaquiz/functions",
    "build:frontend": "npm run build --workspace=@pediaquiz/frontend",
    "build": "npm run build:types && tsc --build --force && npm run build:frontend",
    "setup:local": "npm install && npm run build:types && npm run build:functions",
    "clean": "rm -rf functions/lib packages/types/lib frontend/dist",
    "deploy:functions": "bash ./deploy-functions-master.sh",
    "deploy:functions:batched": "bash ./deploy-functions-master.sh all-batched",
    "deploy:hosting": "npm run build:frontend && firebase deploy --only hosting",
    "prepare": "husky install",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "firebase-tools": "^13.13.2",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": "20"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": "prettier --write"
  }
}
