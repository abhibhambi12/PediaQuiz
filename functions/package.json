{
  "name": "@pediaquiz/functions",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Functions for PediaQuiz",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc --build",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.2.0",
    "@google-cloud/vision": "^4.3.0",
    "@pediaquiz/types": "file:../packages/types",
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.5.4"
  }
}