{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS", // Firebase Functions use CommonJS
    "moduleResolution": "node", // Correct resolution for CommonJS
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "target": "es2021"
  },
  "compileOnSave": true,
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../packages/types"
    }
  ]
}