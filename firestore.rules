// firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based access checks from custom claims
    function getRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return getRole() == 'admin';
    }

    function isFaculty() {
        return getRole() == 'faculty' || isAdmin();
    }

    // --- Content Collections: Read-only for authenticated users, full access for admins/faculty ---
    match /{collection}/{docId} 
    where collection in ['Topics', 'MarrowTopics', 'MasterMCQ', 'MarrowMCQ', 'Flashcards', 'KeyClinicalTopics'] {
      allow read: if isAuthenticated() && resource.data.status == 'approved';
      allow write: if isFaculty();
    }
    
    match /Topics/{topicId}/ChapterNotes/{chapterId} {
       allow read: if isAuthenticated();
       allow write: if isFaculty();
    }

    // --- User-Specific Data Collections ---
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      // Users can only update specific, non-critical fields.
      // Roles, admin status, XP, etc., can only be changed by secure backend functions.
      allow update: if isUser(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['displayName', 'theme', 'updatedAt', 'notificationSettings']);
      allow create, delete: if false; 
    }
    
    match /users/{userId}/{collectionId}/{document=**} {
      allow read, write: if isUser(userId);
    }
    
    // --- Application Data Collections (Managed by Backend) ---
    match /quizResults/{resultId} {
      allow read: if isUser(resource.data.userId) || isAdmin();
      allow create, update, delete: if false; 
    }
    
    match /quizSessions/{sessionId} {
      // Sessions are exclusively managed by backend functions to prevent cheating.
      allow read, write: if false;
    }

    match /cramSheets/{sheetId} {
      // Users have full control over their own cram sheets.
      allow read, create, update, delete: if isUser(resource.data.userId);
    }
    
    match /contentGenerationJobs/{jobId} {
      allow read, write: if isFaculty();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend can write
    }
    
    match /adminConfig/{document} {
      allow read, write: if isAdmin();
    }
  }
}