// firestore.rules
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return getRole() == 'admin';
    }

    function isFaculty() {
      return getRole() == 'faculty' || isAdmin();
    }
    
    function allowReadIfAuthenticated() {
      return isAuthenticated();
    }
    
    match /Topics/{topicId} {
      allow read: if allowReadIfAuthenticated();
      allow write: if request.auth == null || isFaculty();
    }
    match /MarrowTopics/{topicId} {
      allow read: if allowReadIfAuthenticated();
      allow write: if request.auth == null || isFaculty();
    }
    
    match /MasterMCQ/{mcqId} {
      allow read: if resource.data.status == 'approved' && allowReadIfAuthenticated();
      allow write: if request.auth == null || isFaculty();
    }
    match /MarrowMCQ/{mcqId} {
      allow read: if resource.data.status == 'approved' && allowReadIfAuthenticated();
      allow write: if request.auth == null || isFaculty();
    }
    match /Flashcards/{flashcardId} {
      allow read: if resource.data.status == 'approved' && allowReadIfAuthenticated();
      allow write: if request.auth == null || isFaculty();
    }

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow update: if isUser(userId);
      allow create, delete: if isAdmin();
    }
    
    match /users/{userId}/{subcollection}/{docId=**} {
      allow read, write: if isUser(userId);
    }
    
    match /quizResults/{resultId} {
      allow read: if isUser(resource.data.userId) || isAdmin();
      allow write: if request.auth == null; 
    }
    
    match /quizSessions/{sessionId} {
      allow read, update: if isUser(resource.data.userId);
      allow create, delete: if request.auth == null;
    }
    
    match /contentGenerationJobs/{jobId} {
      allow read: if isUser(resource.data.userId) || isFaculty();
      allow write: if request.auth == null;
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if request.auth == null;
    }
    
    match /adminConfig/{docId} {
      allow read: if isFaculty();
      allow write: if isAdmin();
    }
  }
}